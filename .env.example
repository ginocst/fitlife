# Ejemplo (el archivo .env original no se sube a GitHub ya que contiene secretos).

# Clave secreta de Django. Generar con:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# True solo en PC. En el servidor: False
DEBUG=True

# Desde donde se visita el sitio.
ALLOWED_HOSTS=IP_EC2,127.0.0.1,localhost

# Cookies solo por HTTPS. Ya que el servidor es sin certificado se usa False:
COOKIE_SECURE=False

# Si se visita el sitio con un dominio o puerto distinto (por ej: http://XX.XX.XX.XX:8080)
CSRF_TRUSTED_ORIGINS=

# Aforo máximo de las instalaciones (personas dentro a la vez)
AFORO_MAXIMO=50

# PostgreSQL
DB_NAME=fitlife_db
DB_USER=fitlife_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
